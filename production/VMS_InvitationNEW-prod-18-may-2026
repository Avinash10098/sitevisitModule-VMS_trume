    public Static DateTime getUTCDateTime(DateTime dt){
        Datetime GMTDate = Datetime.newInstance(
            dt.year(),
            dt.month(),
            dt.day(),
            dt.hour(),
            dt.minute(),
            dt.second());
        system.debug('GMTDate ::'+GMTDate);
        return GMTDate;
        
    }
    
    
